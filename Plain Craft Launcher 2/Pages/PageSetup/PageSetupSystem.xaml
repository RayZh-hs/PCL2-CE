<local:MyPageRight
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PCL" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    mc:Ignorable="d" x:Class="PageSetupSystem"
    PanScroll="{Binding ElementName=PanBack}">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel x:Name="PanMain" Margin="25,10">
            <local:MyCard Margin="0,0,0,15" Title="{local:Translate General}">
                <StackPanel Margin="25,40,25,15">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="GeneralName" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="28" />
                            <RowDefinition Height="7" />
                        </Grid.RowDefinitions>
                        <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Text="{local:Translate Language}" Margin="0,0,25,0" />
                        <local:MyComboBox x:Name="ComboLanguage" Grid.Column="1" SelectionChanged="ComboLanguage_SelectionChanged">
                            <local:MyComboBoxItem Content="{local:Translate SetupSystem.Language.Chinese}" Tag="zh-CN" />
                            <local:MyComboBoxItem Content="{local:Translate SetupSystem.Language.English}" Tag="en-US" />
                        </local:MyComboBox>
                    </Grid>
                </StackPanel>
            </local:MyCard>
            <local:MyCard Margin="0,15" Title="{local:Translate Download}">
                <StackPanel Margin="25,37,25,15">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="28" />
                            <RowDefinition Height="7" />
                            <RowDefinition Height="28" />
                            <RowDefinition Height="7" />
                            <RowDefinition Height="27" />
                            <RowDefinition Height="27" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="27" />
                        </Grid.RowDefinitions>
                        <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Text="{local:Translate FileDownloadSource}" Margin="0,0,25,0" />
                        <local:MyComboBox x:Name="ComboDownloadSource" Grid.ColumnSpan="2" Tag="ToolDownloadSource" Grid.Column="1">
                            <local:MyComboBoxItem Content="{local:Translate SetupSystem.Source.Mirror}" />
                            <local:MyComboBoxItem Content="{local:Translate SetupSystem.Source.OfficialFirst}" IsSelected="True" />
                            <local:MyComboBoxItem Content="{local:Translate SetupSystem.Source.Official}" />
                        </local:MyComboBox>
                        <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Text="{local:Translate VersionListSource}" Margin="0,0,25,0" Grid.Row="2" />
                        <local:MyComboBox x:Name="ComboDownloadVersion" Grid.ColumnSpan="2" Tag="ToolDownloadVersion" Grid.Column="1" Grid.Row="2">
                            <local:MyComboBoxItem Content="{local:Translate SetupSystem.Source.MirrorOld}" />
                            <local:MyComboBoxItem Content="{local:Translate SetupSystem.Source.OfficialFirst}" IsSelected="True" />
                            <local:MyComboBoxItem Content="{local:Translate SetupSystem.Source.Official}" />
                        </local:MyComboBox>
                        <TextBlock Grid.Row="4" VerticalAlignment="Center" HorizontalAlignment="Left" Text="{local:Translate MaxThreads}" Margin="0,0,25,0" />
                        <local:MySlider x:Name="SliderDownloadThread" Grid.Row="4" Tag="ToolDownloadThread" MaxValue="255" Value="63" Grid.Column="1"
                                        ToolTip="{local:Translate SetupSystem.Download.ThreadHint}" />
                        <TextBlock VerticalAlignment="Center" Grid.Row="5" HorizontalAlignment="Left" Text="{local:Translate SpeedLimit}" Margin="0,0,25,0" />
                        <local:MySlider x:Name="SliderDownloadSpeed" Grid.Row="5" Tag="ToolDownloadSpeed" MaxValue="42" Value="42" Grid.Column="1"
                                        ToolTip="{local:Translate SetupSystem.Download.SpeedLimitHint}" />
                        <TextBlock VerticalAlignment="Top" Grid.Row="6" HorizontalAlignment="Left" Text="{local:Translate TargetFolder}" Margin="0,5,25,5" />
                        <TextBlock Margin="0,5" HorizontalAlignment="Left" Text="{local:Translate SetupSystem.Folder.Hint}" Grid.Row="6" Grid.Column="1" VerticalAlignment="Center" Opacity="0.5" />
                        <TextBlock Margin="0,5" Grid.Row="7" Text="{local:Translate SetupSystem.Install.Behavior}" />
                        <local:MyCheckBox Grid.Row="7" Grid.Column="1" Text="{local:Translate SetupSystem.Install.AutoSelect}" x:Name="CheckDownloadAutoSelectVersion" Tag="ToolDownloadAutoSelectVersion" />
                        <local:MyCheckBox Grid.Row="7" Grid.Column="1" Margin="230,0,0,0" Text="{local:Translate SetupSystem.Install.Authlib}" x:Name="CheckFixAuthlib" Tag="ToolFixAuthlib" ToolTip="{local:Translate SetupSystem.Install.AuthlibHint}"/>
                    </Grid>
                </StackPanel>
            </local:MyCard>
            <local:MyCard Margin="0,0,0,15" Title="{local:Translate CommunityResources}">
                <StackPanel Margin="25,37,25,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="28" />
                            <RowDefinition Height="7" />
                            <RowDefinition Height="28" />
                            <RowDefinition Height="7" />
                            <RowDefinition Height="28" />
                            <RowDefinition Height="7" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Left" Text="{local:Translate SetupSystem.Download.Source}" Margin="0,0,25,0" />
                        <local:MyComboBox x:Name="ComboDownloadMod" Grid.Row="0" Grid.ColumnSpan="2" Tag="ToolDownloadMod" Grid.Column="1">
                            <local:MyComboBoxItem Content="{local:Translate SetupSystem.Source.Mirror}" />
                            <local:MyComboBoxItem Content="{local:Translate SetupSystem.Download.OfficialFirstShort}" IsSelected="True" />
                            <local:MyComboBoxItem Content="{local:Translate SetupSystem.Source.Official}" />
                        </local:MyComboBox>
                        <TextBlock Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Left" Text="{local:Translate SetupSystem.Download.Format}" Margin="0,0,25,0" />
                        <local:MyComboBox Grid.Row="2" x:Name="ComboDownloadTranslateV2" Grid.ColumnSpan="2" Tag="ToolDownloadTranslateV2" Grid.Column="1" 
                                          ToolTip="{local:Translate SetupSystem.Download.FormatHint}">
                            <local:MyComboBoxItem Content="{local:Translate SetupSystem.Download.Format.Example1}" />
                            <local:MyComboBoxItem Content="{local:Translate SetupSystem.Download.Format.Example2}" IsSelected="True" />
                            <local:MyComboBoxItem Content="{local:Translate SetupSystem.Download.Format.Example3}" />
                            <local:MyComboBoxItem Content="{local:Translate SetupSystem.Download.Format.Example4}" />
                            <local:MyComboBoxItem Content="{local:Translate SetupSystem.Download.Format.Example5}" />
                        </local:MyComboBox>
                        <TextBlock Grid.Row="4" VerticalAlignment="Center" HorizontalAlignment="Left" Text="{local:Translate SetupSystem.Mod.Style}" Margin="0,0,25,0" />
                        <local:MyComboBox Grid.Row="4" x:Name="ComboModLocalNameStyle" Grid.ColumnSpan="2" Tag="ToolModLocalNameStyle" Grid.Column="1" 
                                          ToolTip="{local:Translate SetupSystem.Download.FormatHint}">
                            <local:MyComboBoxItem Content="{local:Translate SetupSystem.Mod.Style.Translated}" IsSelected="True" />
                            <local:MyComboBoxItem Content="{local:Translate SetupSystem.Mod.Style.Filename}" />
                        </local:MyComboBox>
                        <local:MyCheckBox Margin="0,2,0,4" Text="{local:Translate SetupSystem.Mod.IgnoreQuilt}" Grid.Row="6" Height="22" Grid.ColumnSpan="2"
                                          x:Name="CheckDownloadIgnoreQuilt" Tag="ToolDownloadIgnoreQuilt" />
                        <local:MyCheckBox Margin="240,2,0,4" Text="{local:Translate SetupSystem.Clipboard.Auto}" Grid.Row="6" Height="22" Grid.ColumnSpan="2"
                                          x:Name="CheckDownloadClipboard" Tag="ToolDownloadClipboard" ToolTip="{local:Translate SetupSystem.Clipboard.Hint}"/>
                    </Grid>
                </StackPanel>
            </local:MyCard>
            <local:MyCard Margin="0,0,0,15" Title="{local:Translate Accessibility}">
                <Grid Margin="25,40,25,17">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="22" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="22" />
                    </Grid.RowDefinitions>
                    <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Text="{local:Translate SetupSystem.Update.Game}" Margin="0,0,25,0" />
                    <local:MyCheckBox Text="{local:Translate SetupSystem.Update.Release}" Grid.Column="1" x:Name="CheckUpdateRelease" Tag="ToolUpdateRelease" ToolTip="{local:Translate SetupSystem.Update.ReleaseHint}" />
                    <local:MyCheckBox Text="{local:Translate SetupSystem.Update.Snapshot}" Grid.Column="2" Height="22" x:Name="CheckUpdateSnapshot" Tag="ToolUpdateSnapshot" ToolTip="{local:Translate SetupSystem.Update.SnapshotHint}" />
                    <TextBlock VerticalAlignment="Center" Grid.Row="2" HorizontalAlignment="Left" Text="{local:Translate SetupSystem.Game.Language}" Margin="0,0,25,0" />
                    <local:MyCheckBox Text="{local:Translate SetupSystem.Game.AutoChinese}" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="5" x:Name="CheckHelpChinese" Tag="ToolHelpChinese" />
                </Grid>
            </local:MyCard>
            <local:MyCard Margin="0,0,0,15" Title="{local:Translate System}">
                <Grid Margin="25,40,25,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="28" />
                        <RowDefinition Height="9" />
                        <RowDefinition Height="28" />
                        <RowDefinition Height="5" />
                        <RowDefinition Height="28" />
                        <RowDefinition Height="5" />
                        <RowDefinition Height="20" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Text="{local:Translate SetupSystem.Launcher.Announcement}" Margin="0,0,25,0" Grid.Row="0" />
                    <local:MyComboBox x:Name="ComboSystemActivity" Tag="SystemSystemActivity" Grid.Column="1" Grid.Row="0">
                        <local:MyComboBoxItem Content="{local:Translate SetupSystem.Announcement.All}" ToolTip="{local:Translate SetupSystem.Announcement.AllHint}" />
                        <local:MyComboBoxItem Content="{local:Translate SetupSystem.Announcement.Important}" />
                        <local:MyComboBoxItem Content="{local:Translate SetupSystem.Announcement.None}" />
                    </local:MyComboBox>
                    <TextBlock Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Left" Text="{local:Translate SetupSystem.Launcher.FPS}" Margin="0,0,25,0" />
                    <local:MySlider x:Name="SliderAniFPS" Grid.Row="2" Tag="UiAniFPS" MaxValue="59" Value="59" Grid.Column="1"
                                    ToolTip="{local:Translate SetupSystem.Launcher.FPSHint}" />
                    <TextBlock Grid.Row="4" VerticalAlignment="Center" HorizontalAlignment="Left" Text="{local:Translate SetupSystem.Launcher.LogLines}" Margin="0,0,25,0" />
                    <local:MySlider x:Name="SliderMaxLog" Grid.Row="4" Tag="SystemMaxLog" MaxValue="29" Value="13" Grid.Column="1"
                                    ToolTip="{local:Translate SetupSystem.Launcher.LogLinesHint}" />
                    <Grid Grid.Row="6" Grid.ColumnSpan="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="CheckBox" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="CheckBox" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="CheckBox" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="CheckBox" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="20"/>
                        </Grid.RowDefinitions>
                        <local:MyCheckBox Grid.Row="0" Grid.Column="0" Text="{local:Translate SetupSystem.Launcher.NoHWAccel}" x:Name="CheckSystemDisableHardwareAcceleration" Tag="SystemDisableHardwareAcceleration"/>
                        <local:MyCheckBox Grid.Row="0" Grid.Column="1" Text="{local:Translate SetupSystem.Launcher.Survey}" x:Name="CheckSystemTelemetry" Tag="SystemTelemetry" 
                                      ToolTip="{local:Translate SetupSystem.Launcher.SurveyHint}"/>
                    </Grid>
                    <Grid Grid.Row="8" Grid.ColumnSpan="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Button" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Button" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Button" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Button" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="35"/>
                        </Grid.RowDefinitions>
                        <local:MyButton Grid.Column="0" Grid.Row="0" x:Name="BtnSystemSettingExp" MinWidth="100" Text="{local:Translate SetupSystem.Settings.Export}" Padding="13,0" Margin="0,0,20,0"/>
                        <local:MyButton Grid.Column="1" Grid.Row="0" x:Name="BtnSystemSettingImp" MinWidth="100" Text="{local:Translate SetupSystem.Settings.Import}" Padding="13,0" Margin="0,0,20,0"/>
                    </Grid>
                </Grid>
            </local:MyCard>
            
            <!-- <local:MyCard x:Name="CardMain" Margin="0,15" Title="全局设置">
                <StackPanel Margin="25,40,25,15">
                    <Grid x:Name="PanMainLang" Height="28" Margin="0,0,0,10" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Text="语言" Margin="0,0,25,0" />
                        <local:MyComboBox x:Name="ComboBackgroundSuit" Tag="UiBackgroundSuit" HorizontalAlignment="Left" Width="170" Grid.Column="1">
                            <local:MyComboBoxItem Content="简体中文" Tag="zh_CN" IsSelected="True" />
                            <local:MyComboBoxItem Content="繁體中文" Tag="zh_HK" />
                            <local:MyComboBoxItem Content="English" Tag="en_US" />
                        </local:MyComboBox>
                    </Grid>
                </StackPanel>
            </local:MyCard> -->

            <local:MyCard Margin="0,0,0,15" Title="{local:Translate SetupSystem.Network.Title}">
                <Grid Margin="25,38,25,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="28" />
                        <RowDefinition Height="4" />
                        <RowDefinition Height="28" />
                        <RowDefinition Height="4" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <local:MyCheckBox x:Name="CheckNetDohEnable" Tag="SystemNetEnableDoH" Grid.Row="0" Grid.ColumnSpan="2" Text="{local:Translate SetupSystem.Network.DoH}" ToolTip="{local:Translate SetupSystem.Network.DoHHint}"/>
                    <TextBlock Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Left" Text="{local:Translate SetupSystem.Network.Proxy}" Margin="0,0,25,0" />
                    <Grid Grid.Row="2" Grid.Column="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="0.2*" />
                        </Grid.ColumnDefinitions>
                        <local:MyRadioBox Text="{local:Translate SetupSystem.Proxy.None}" x:Name="RadioHttpProxyType0" Height="22" Tag="SystemHttpProxyType/0" Grid.Column="0" />
                        <local:MyRadioBox Text="{local:Translate SetupSystem.Proxy.System}" x:Name="RadioHttpProxyType1" Height="22" Tag="SystemHttpProxyType/1" Grid.Column="1" />
                        <local:MyRadioBox Text="{local:Translate SetupSystem.Proxy.Custom}" x:Name="RadioHttpProxyType2" Height="22" Tag="SystemHttpProxyType/2" Grid.Column="2" />
                    </Grid>
                    <Grid Grid.Row="4" Grid.Column="1" x:Name="HttpProxyCustom" Visibility="{Binding ElementName=RadioHttpProxyType2,Path=Checked,Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="28"/>
                            <RowDefinition Height="9"/>
                            <RowDefinition Height="28"/>
                            <RowDefinition Height="9"/>
                            <RowDefinition Height="28"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <local:MyHint Text="{local:Translate SetupSystem.Proxy.Warn}" Grid.Row="0" Grid.ColumnSpan="5" Theme="Yellow"/>
                        <local:MyTextBox x:Name="TextSystemHttpProxy" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="5" Tag="SystemHttpProxy" HintText="{local:Translate SetupSystem.Proxy.Example}" ToolTip="{local:Translate SetupSystem.Proxy.Hint}"/>
                        <TextBlock Grid.Column="0" Grid.Row="4" Text="{local:Translate SetupSystem.Proxy.User}" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,0,5,0"/>
                        <local:MyTextBox Grid.Column="1" Grid.Row="4" HintText="{local:Translate SetupSystem.Proxy.IfAny}" Tag="SystemHttpProxyCustomUsername" x:Name="TextSystemHttpProxyCustomUsername" Margin="0,0,5,0"/>
                        <TextBlock Grid.Column="2" Grid.Row="4" Text="{local:Translate SetupSystem.Proxy.Pass}" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,0,5,0"/>
                        <local:MyTextBox Grid.Column="3" Grid.Row="4" HintText="{local:Translate SetupSystem.Proxy.IfAny}" Tag="SystemHttpProxyCustomPassword" x:Name="TextSystemHttpProxyCustomPassword" Margin="0,0,5,0"/>
                        <local:MyButton Text="{local:Translate SetupSystem.Proxy.Apply}" TextPadding="3" Grid.Row="4" Grid.Column="4" x:Name="BtnApplyHttpProxy"/>
                    </Grid>
                </Grid>
            </local:MyCard>

            <local:MyCard x:Name="CardDebug" Margin="0,0,0,15" Title="{local:Translate DebugOptions}" CanSwap="True" IsSwapped="True">
                <StackPanel Margin="25,40,25,15">
                    <Grid x:Name="PanDebugAnim" Height="22" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Text="{local:Translate SetupSystem.Debug.AnimSpeed}" Margin="0,0,25,0" />
                        <local:MySlider x:Name="SliderDebugAnim" Tag="SystemDebugAnim" MaxValue="30" Grid.Column="1" />
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.5*" />
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <local:MyCheckBox Grid.Column="0" Text="{local:Translate SetupSystem.Debug.SkipCopy}" Height="22" x:Name="CheckDebugSkipCopy" Tag="SystemDebugSkipCopy" ToolTip="{local:Translate SetupSystem.Debug.SkipCopyHint}" />
                        <local:MyCheckBox Grid.Column="1" Text="{local:Translate SetupSystem.Debug.Mode}" Height="22" x:Name="CheckDebugMode" Tag="SystemDebugMode" ToolTip="{local:Translate SetupSystem.Debug.ModeHint}" />
                        <local:MyCheckBox Grid.Column="2" Text="{local:Translate SetupSystem.Debug.Delay}" Height="22" x:Name="CheckDebugDelay" Tag="SystemDebugDelay" ToolTip="{local:Translate SetupSystem.Debug.DelayHint}" />
                    </Grid>
                </StackPanel>
            </local:MyCard>
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
