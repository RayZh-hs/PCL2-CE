<local:MyPageRight
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PCL" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:i18n="clr-namespace:PCL.Core.UI;assembly=PCL.Core"
    mc:Ignorable="d" x:Class="PageSelectLanguage"
    Title="{i18n:Translate Key='LanguageSelectionTitle'}">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="40" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="40" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        
        <TextBlock Grid.Row="0" x:Name="TitleTextBlock" Text="{i18n:Translate Key='LanguageSelectionPrompt'}"
                   FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" />
        
        <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center">
            <local:MyButton x:Name="BtnChinese" MinWidth="200" Margin="0,10" Padding="20,15"
                           Text="简体中文" Click="BtnChinese_Click" />
            <local:MyButton x:Name="BtnEnglish" MinWidth="200" Margin="0,10" Padding="20,15"
                           Text="English" Click="BtnEnglish_Click" />
        </StackPanel>
        
        <TextBlock Grid.Row="4" x:Name="NoteTextBlock" Text="{i18n:Translate Key='LanguageSelectionNote'}"
                   FontSize="12" HorizontalAlignment="Center" Opacity="0.7" />
    </Grid>
</local:MyPageRight>