<local:MyPageRight
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PCL" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:i18n="clr-namespace:PCL.Core.UI;assembly=PCL.Core"
    mc:Ignorable="d" x:Class="PageDownloadShader"
    PanScroll="{Binding ElementName=Content}">
    <local:PageComp x:Name="Content" PageType="Shader" TypeName="ShaderPack" TypeNameSpaced=" ShaderPack">
        <local:MyComboBoxItem Tag="" Content="{i18n:Translate Key='Download.Comp.Filter.Source.All'}" IsSelected="True" />

        <local:MyComboBoxItem Content="{i18n:Translate Key='Download.Comp.Tag.Shader.Style'}" IsEnabled="False" />
        <local:MyComboBoxItem Margin="15,0,0,0" Content="{i18n:Translate Key='Download.Comp.Tag.Shader.VanillaLike'}" Tag="6555/vanilla-like" />
        <local:MyComboBoxItem Margin="15,0,0,0" Content="{i18n:Translate Key='Download.Comp.Tag.Shader.Fantasy'}" Tag="6554/fantasy" />
        <local:MyComboBoxItem Margin="15,0,0,0" Content="{i18n:Translate Key='Download.Comp.Tag.Shader.Realistic'}" Tag="6553/realistic" />
        <local:MyComboBoxItem Margin="15,0,0,0" Content="{i18n:Translate Key='Download.Comp.Tag.Shader.SemiRealistic'}" Tag="/semi-realistic" />
        <local:MyComboBoxItem Margin="15,0,0,0" Content="{i18n:Translate Key='Download.Comp.Tag.Shader.Cartoon'}" Tag="/cartoon" />

        <local:MyComboBoxItem Content="{i18n:Translate Key='Download.Comp.Tag.Shader.Features'}" IsEnabled="False" />
        <local:MyComboBoxItem Margin="15,0,0,0" Content="{i18n:Translate Key='Download.Comp.Tag.Shader.ColoredLighting'}" Tag="/colored-lighting" />
        <local:MyComboBoxItem Margin="15,0,0,0" Content="{i18n:Translate Key='Download.Comp.Tag.Shader.PathTracing'}" Tag="/path-tracing" />
        <local:MyComboBoxItem Margin="15,0,0,0" Content="{i18n:Translate Key='Download.Comp.Tag.Shader.PBR'}" Tag="/pbr" />
        <local:MyComboBoxItem Margin="15,0,0,0" Content="{i18n:Translate Key='Download.Comp.Tag.Shader.Reflections'}" Tag="/reflections" />

        <local:MyComboBoxItem Content="{i18n:Translate Key='Download.Comp.Tag.Shader.PerformanceCost'}" IsEnabled="False" />
        <local:MyComboBoxItem Margin="15,0,0,0" Content="{i18n:Translate Key='Download.Comp.Tag.Shader.Potato'}" Tag="/potato" />
        <local:MyComboBoxItem Margin="15,0,0,0" Content="{i18n:Translate Key='Download.Comp.Tag.Shader.Low'}" Tag="/low" />
        <local:MyComboBoxItem Margin="15,0,0,0" Content="{i18n:Translate Key='Download.Comp.Tag.Shader.Medium'}" Tag="/medium" />
        <local:MyComboBoxItem Margin="15,0,0,0" Content="{i18n:Translate Key='Download.Comp.Tag.Shader.High'}" Tag="/high" />


    </local:PageComp>
</local:MyPageRight>
